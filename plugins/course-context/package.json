{
  "name": "course-context",
  "version": "1.0.0",
  "description": "Course notes: per-course accent colour, course badge, and course metadata in the content index",
  "type": "module",
  "private": true,
  "exports": {
    ".": { "import": "./dist/index.js" },
    "./components": { "import": "./dist/components/index.js" },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "peerDependencies": { "preact": "^10.0.0" },
  "quartz": {
    "name": "course-context",
    "displayName": "Course Context",
    "category": ["transformer", "component"],
    "version": "1.0.0",
    "quartzVersion": ">=5.1.0",
    "defaultOrder": 15,
    "defaultEnabled": true,
    "defaultOptions": {},
    "components": {
      "CourseBadge": { "displayName": "Course Badge", "defaultPosition": "beforeBody", "defaultPriority": 6 }
    }
  }
}
