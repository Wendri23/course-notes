      "component"
    ],
    "version": "1.0.0",
    "quartzVersion": ">=5.1.0",
    "defaultEnabled": true,
    "defaultOptions": {},
    "components": {
      "BackLink": {
        "displayName": "Course Back Link",
        "defaultPosition": "right",
        "defaultPriority": 90
      }
    }
  }
}