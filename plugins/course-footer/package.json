{
  "name": "course-footer",
  "version": "1.0.0",
  "description": "Course notes: footer with credit and light/dark switch",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./components": {
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "quartz": {
