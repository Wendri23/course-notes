      "component"
    ],
    "version": "1.0.0",
    "quartzVersion": ">=5.1.0",
    "defaultEnabled": true,
    "defaultOptions": {},
    "components": {
      "SiteFooter": {
        "displayName": "Course Footer",
        "defaultPosition": "footer",
        "defaultPriority": 50
